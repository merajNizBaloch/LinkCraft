# Server-only Supabase credentials for the dedicated LinkCraft project.
# Never prefix the secret key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Public base URL used when LinkCraft returns a newly shortened URL.
# Local example: http://localhost:3000
# Production example: https://linkcraft.techcraftsolution.com
LINKCRAFT_PUBLIC_URL=http://localhost:3000
