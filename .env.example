# LinkCraft local/server environment.
# Cloudflare Workers already receives SUPABASE_URL from wrangler.jsonc.
SUPABASE_URL=https://sewnndspsnafutgfdhfy.supabase.co

# Keep this secret server-side. On Cloudflare add it as a Worker Secret,
# never as a plaintext variable and never with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=sb_secret_replace_me

# Optional. LinkCraft falls back to the current request origin when omitted.
# Local example: http://localhost:3000
# Production example: https://linkcraft.techcraftsolution.com
LINKCRAFT_PUBLIC_URL=http://localhost:3000
